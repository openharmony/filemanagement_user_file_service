@!namespace("@ohos.file.cloudDiskManager", "cloudDiskManager")

@!sts_inject("""
static { loadLibrary("clouddiskmanager_taihe.z"); }
""")

enum SyncFolderState: i32 {
    INACTIVE = 0,
    ACTIVE = 1
}

struct SyncFolder {
    path: String;
    bundleName: String;
    state: SyncFolderState;
    displayNameResId: Optional<i32>;
    customAlias: Optional<String>;
    isSupportPlaceHolder: Optional<bool>;
}

@class
interface SyncFolderAccessor {
  @gen_promise("getAllSyncFolders")
  GetAllSyncFoldersSync(): Array<SyncFolder>;
}

@ctor("SyncFolderAccessor")
function CreateSyncFolderAccessor(): SyncFolderAccessor;

enum CallbackType: i32 {
    FETCH_DATA = 0,
    CANCEL_FETCH_DATA = 1,
    DEHYDRATE = 2
}

enum HydratePriority: i32 {
    LOW = 0,
    NORMAL = 1,
    HIGH = 2
}

enum HydrateProgressState: i32 {
    PENDING = 0,
    IN_PROGRESS = 1,
    COMPLETED = 2,
    CANCELLED = 3
}

struct HydrateProgress {
    filePath: String;
    state: HydrateProgressState;
    processedSize: f64;
    totalSize: f64;
}

@class
interface CloudDiskSystemAccessor {
    @rename("on")
    OnHydrateProgress(type: @literal("hydrateProgress") unit, callback: (data: HydrateProgress) => void): void;

    @rename("off")
    OffHydrateProgress(type: @literal("hydrateProgress") unit,
        @optional callback: Optional<(data: HydrateProgress) => void>): void;

    @rename("hydratePlaceholder")
    @promise
    HydratePlaceholderSync(filePath: String, callbackType: CallbackType, priority: HydratePriority): void;

    @rename("dehydrateFile")
    @promise
    DehydrateFileSync(filePath: String): void;
}

@ctor("CloudDiskSystemAccessor")
function CreateCloudDiskSystemAccessor(): CloudDiskSystemAccessor;
